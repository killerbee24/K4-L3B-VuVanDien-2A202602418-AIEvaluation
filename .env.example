# Used only by domain_assistant.py when generating real RAG answers.
# Copy this file to .env, then use the API key and model ID shown by MWAPI.
AI_PROVIDER=mwapi
MWAPI_API_KEY=your_mwapi_api_key_here
MWAPI_BASE_URL=https://api.mwapi.dev
MWAPI_MODEL=replace_with_a_model_id_from_mwapi_model_plaza

# Optional OpenAI configuration. Set AI_PROVIDER=openai to use it.
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
